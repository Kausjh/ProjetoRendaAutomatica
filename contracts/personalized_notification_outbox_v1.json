{
  "schema": "projeto-renda-automatica.personalized-notification-outbox",
  "outbox_version": 1,
  "stage": "delivery-foundation",
  "network_exposure": false,
  "actual_delivery_enabled": false,
  "intended_channel": "push",
  "dependencies": {
    "personalized_alert_matching": "contracts/personalized_alert_matching_v1.json",
    "user_identity": "contracts/user_identity_v1.json",
    "user_personalization": "contracts/user_personalization_v1.json"
  },
  "persistence": {
    "engine": "sqlite",
    "database": "database/user_identity.sqlite3",
    "unique_by": [
      "match_id",
      "channel"
    ],
    "statuses": [
      "pending",
      "processing",
      "delivered",
      "failed"
    ],
    "retry_supported": true,
    "attempt_counter": true
  },
  "delivery": {
    "push_ready": true,
    "push_provider_configured": false,
    "device_tokens_supported": false,
    "provider_credentials_stored": false,
    "external_network_calls": false
  },
  "boundaries": {
    "application_api_v1_remains_read_only": true,
    "new_http_routes": false,
    "telegram_delivery": false,
    "email_delivery": false,
    "admin_api_is_not_notification_api": true,
    "private_android_admin_app_is_not_public_user_app": true
  },
  "future_consumers": [
    "push dispatcher",
    "public app device registration",
    "personalized feed",
    "web interface",
    "browser extension"
  ]
}
