{
  "schema": "projeto-renda-automatica.public-app-device-binding",
  "device_binding_version": 1,
  "stage": "client-integration",
  "backend": {
    "list_route": "GET /api/v1/me/devices",
    "bind_route": "PUT /api/v1/me/devices/{instalacao_id}",
    "revoke_route": "DELETE /api/v1/me/devices/{instalacao_id}",
    "account_identity_source": "X-User-Session",
    "client_sends_account_id": false
  },
  "installation_identity": {
    "storage": "expo-secure-store",
    "key": "pra_public_installation_id_v1",
    "generated_once": true,
    "generator": "expo-crypto.randomUUID",
    "cleared_on_logout": false
  },
  "push_token": {
    "provider": "expo-push-service",
    "library": "expo-notifications",
    "project_id_required": true,
    "project_id_committed_as_placeholder": false,
    "token_logged": false,
    "token_rendered": false,
    "token_persisted_by_public_app": false
  },
  "lifecycle": {
    "bind_after_authenticated_bootstrap": true,
    "bind_after_login_via_authenticated_state": true,
    "refresh_token_on_future_app_boot": true,
    "revoke_before_explicit_logout": true,
    "logout_blocked_by_device_revoke_failure": false
  },
  "runtime": {
    "expo_sdk": 57,
    "expo_go_remote_push_supported": false,
    "development_build_required_for_remote_push": true,
    "expo_go_binding_deferred_without_error": true,
    "real_push_token_validation_completed": true,
    "real_push_token_validation_date": "2026-09-19",
    "real_push_token_validation_platform": "android"
  },
  "delivery": {
    "push_delivery_implemented": false,
    "dispatcher_implemented": false
  },
  "next_step": "development-build-push-credentials-and-real-token-validation-v1"
}
