# ============================================================
# Projeto Renda Automática
# Arquivo de exemplo (.env.example)
#
# Copie para ".env" e preencha com suas credenciais.
# Nunca envie seu .env para o GitHub.
# ============================================================

# ------------------------------------------------------------
# TELEGRAM (obrigatório)
# ------------------------------------------------------------

# Token do bot, obtido no @BotFather
TELEGRAM_BOT_TOKEN=

# ID do canal (ex.: -1001234567890) ou @nome do canal público
CHANNEL_ID=

# ------------------------------------------------------------
# IDENTIDADE (obrigatório)
# ------------------------------------------------------------

# Somente letras minúsculas, números, hífen ou underline
IDENTIFICADOR_MARCA=radar_de_ofertas

# ------------------------------------------------------------
# AFILIADOS
# ------------------------------------------------------------

ARQUIVO_AFILIADORES=config/afiliadores.json

# ------------------------------------------------------------
# COLETA E PUBLICAÇÃO
# ------------------------------------------------------------

# Ofertas coletadas por scraper em cada execução
LIMITE_OFERTAS=40

# Máximo de publicações por execução
MAXIMO_PUBLICACOES=5

# Pausa entre publicações, em segundos
INTERVALO_PUBLICACOES=2

# ------------------------------------------------------------
# FILTROS DE OFERTA
# ------------------------------------------------------------

# Desconto mínimo aceito, de 0 a 100
DESCONTO_MINIMO=0

# Preço máximo aceito
PRECO_MAXIMO=10000

# ------------------------------------------------------------
# MADRUGADA RELÂMPAGO
#
# Das 23h às 8h, ofertas apenas boas ficam guardadas para depois.
# Só passam promoções realmente excepcionais, com histórico mínimo,
# queda forte e pontuação alta. Quedas extremas ficam retidas para a
# futura validação de anomalias/preço bugado.
# ------------------------------------------------------------

RESTRICAO_MADRUGADA_ATIVA=true

HORA_INICIO_MADRUGADA=23
HORA_FIM_MADRUGADA=8

# Queda forte necessária para uma oferta relâmpago comum
QUEDA_MINIMA_MADRUGADA=25

# Novo menor preço pode passar com uma queda um pouco menor,
# mas ainda exige pontuação e histórico fortes
QUEDA_MINIMA_MENOR_PRECO_MADRUGADA=15

# Pontuação total mínima (0 a 100)
PONTUACAO_MINIMA_MADRUGADA=90

# Quantidade mínima de verificações do nosso próprio histórico
REGISTROS_MINIMOS_MADRUGADA=3

# Nota mínima dos fatores que interessam ao comprador (0 a 80)
NOTA_COMPRADOR_MINIMA_MADRUGADA=60

# Acima disso a queda é tratada como anormal e NÃO é publicada
# automaticamente até existir a camada de validação anti-golpe/anomalia
QUEDA_MAXIMA_AUTOMATICA_MADRUGADA=55


# ------------------------------------------------------------
# DETECTOR DE ANOMALIA / POSSÍVEL PREÇO BUGADO
#
# A camada NÃO garante que a loja honrará o preço. Ela detecta quedas
# muito fora do padrão, exige histórico e sinais mínimos de confiança,
# e retém automaticamente casos extremos ou suspeitos.
# ------------------------------------------------------------

DETECTOR_ANOMALIA_ATIVO=true

# A partir desta queda o preço entra na camada de anomalias
QUEDA_MINIMA_ANOMALIA=45

# A partir desta queda, se passar nas validações, recebe o rótulo
# "POSSÍVEL PREÇO BUGADO"
QUEDA_MINIMA_PRECO_BUGADO=55

# Acima deste percentual o projeto NÃO publica automaticamente
QUEDA_MAXIMA_ANOMALIA_PUBLICAVEL=75

# Histórico mínimo para publicar uma anomalia automaticamente
REGISTROS_MINIMOS_ANOMALIA=4

# Confiança mínima calculada pelo detector (0 a 100)
CONFIANCA_MINIMA_ANOMALIA=75


# ------------------------------------------------------------
# RUNTIME UNIFICADO
#
# `python runtime.py` mantém o bot de consulta ativo e dispara
# o pipeline periodicamente usando o launcher/Chrome já existentes.
# ------------------------------------------------------------

# Intervalo entre os horários agendados do pipeline
RUNTIME_INTERVALO_MINUTOS=30

# true = roda um ciclo assim que o runtime inicia
# false = espera o primeiro intervalo antes de rodar
RUNTIME_EXECUTAR_AO_INICIAR=true

# Reinicia o bot de consulta automaticamente se ele cair
RUNTIME_REINICIAR_BOT=true

# Frequência com que o runtime verifica o bot e o agendamento
RUNTIME_INTERVALO_MONITORAMENTO_SEGUNDOS=2

# Espera antes de tentar reiniciar o bot após uma falha
RUNTIME_ATRASO_REINICIO_BOT_SEGUNDOS=5

# Porta APENAS local usada como trava para impedir dois runtimes simultâneos
RUNTIME_PORTA_TRAVA=48731
